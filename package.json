{
  "name": "@adobe/reactor-sdk",
  "version": "2.0.0-beta.5",
  "description": "JavaScript SDK for the Reactor API",
  "author": {
    "name": "Adobe Systems",
    "url": "https://developer.adobelaunch.com/api/",
    "email": "reactor@adobe.com"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/adobe/reactor-sdk-javascript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https@github.com:adobe/reactor-sdk-javascript.git"
  },
  "keywords": [
    "Adobe",
    "Launch",
    "tag manager",
    "SDK"
  ],
  "type": "module",
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/node/index.js",
  "browser": "dist/reactor-sdk.min.js",
  "exports": {
    ".": {
      "import": "./lib/node/index.js",
      "require": "./lib/cjs/index.cjs"
    }
  },
  "targets": {
    "default": {
      "context": "browser",
      "includeNodeModules": true
    },
    "browserGlobal": {
      "context": "browser",
      "distDir": "dist/",
      "outputFormat": "global",
      "isLibrary": true,
      "sourceMap": true,
      "publicUrl": "./",
      "optimize": true
    },
    "integrationTestBrowser": {
      "distDir": "tmp.tests/integration-library-sdk/"
    },
    "integrationTestBundled": {
      "distDir": "tmp.tests/integration-bundled-sdk/"
    },
    "integrationTestNode": {
      "distDir": "tmp.tests/integration-in-node/",
      "outputFormat": "esmodule"
    },
    "main": false
  },
  "scripts": {
    "prepare": "npm run build:production && husky install",
    "postinstall": "node scripts/check-version.js",
    "build:production": "npm run clean && npm run lint && npm-run-all --parallel 'src:build:*'",
    "test": "npm run build:production && npm-run-all --parallel test:unit test:integration",
    "test:unit": "babel test/unit --out-dir tmp.tests/unit/ --source-maps && node scripts/check-version && jasmine tmp.tests/unit/index.js",
    "test:integration": "npm run build:production && HEADLESS=true node test/integration/generate-access-token.cjs && parcel build --no-optimize --public-url=. test/integration/integration-tests-library-sdk.html --target integrationTestBrowser && parcel build --no-optimize --public-url=. test/integration/integration-tests-bundled-sdk.html --target integrationTestBundled && parcel build --no-optimize --public-url=. test/integration/integration-tests-library-sdk.js --target integrationTestNode && HEADLESS=true node scripts/run-integration-tests.js",
    "lint": "eslint --fix 'src/**/*.js' 'test/**/*.js' 'scripts/**/*.js'",
    "lint:check": "eslint 'src/**/*.js' 'test/**/*.js' 'scripts/**/*.js'",
    "lint:staged": "lint-staged",
    "clean": "rm -rf dist lib && npm run clean:integration:setup",
    "clean:integration:setup": "rm -rf tmp.tests",
    "version": "genversion --es6 --semi src/version.js && git add src/version.js",
    "src:build:node": "babel src/ --out-dir lib/node/ --source-maps",
    "src:build:cjs": "BABEL_ENV=cjs babel src/ --out-dir lib/cjs/ --source-maps --out-file-extension .cjs && node scripts/fix-cjs-paths.cjs",
    "src:build:browser": "BABEL_ENV=browser babel src/ --out-dir lib/browser/ --source-maps",
    "src:build:browser.bundle": "parcel build src/index.js --target browserGlobal --no-source-maps && mv dist/index.js dist/reactor-sdk.min.js"
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 safari versions",
    "last 2 edge versions"
  ],
  "files": [
    "dist",
    "lib",
    "scripts"
  ],
  "dependencies": {
    "semver": "^6.3.1"
  },
  "devDependencies": {
    "@adobe/auth-token": "^1.0.1",
    "@babel/cli": "^7.24.8",
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "commander": "3.0.0",
    "dateformat": "3.0.3",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "express": "^4.21.2",
    "genversion": "^2.1.1",
    "glob": "^10.4.5",
    "husky": "^6.0.0",
    "jasmine": "3.5.0",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.3",
    "mkdirp": "^3.0.1",
    "msw": "^2.11.6",
    "nock": "11.5.0",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.16.0",
    "path": "0.12.7",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix"
    ],
    "test/**/*.js": [
      "eslint --fix"
    ],
    "scripts/**/*.js": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=v22.19.0"
  }
}
